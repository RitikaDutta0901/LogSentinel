# Application
PORT=4000
NODE_ENV=development

# PostgreSQL connection (single URL takes precedence)
DATABASE_URL=postgres://user:password@localhost:5432/logsentinel

# Or use individual settings (ignored when DATABASE_URL is set)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=logsentinel

# Optional: set to "true" for managed Postgres that requires SSL
PGSSL=false

# AI analysis and embeddings (Google Gemini)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
# GEMINI_TIMEOUT_MS=30000
# GEMINI_EMBEDDING_TIMEOUT_MS=10000
